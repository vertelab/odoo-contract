<?xml version='1.0' encoding='utf-8'?>
<odoo>
    <record id="product_pricelist_item_form_view" model="ir.ui.view">
        <field name="name">product.pricelist.item.form</field>
        <field name="model">product.pricelist.item</field>
        <field name="inherit_id" ref="product.product_pricelist_item_form_view"/>
        <field name="arch" type="xml">
            <field name="min_quantity" position="after">
                 <field name="fixed_price" widget="monetary" options="{'currency_field': 'currency_id', 'field_digits': True}"/>
            </field>

            <xpath expr="//label[@for='fixed_price']" position="replace">
                <label for="fixed_price" invisible="compute_price not in ['fixed', 'index']"/>
            </xpath>

            <xpath expr="//div[hasclass('o_row')][1]" position="replace">
                <div class="o_row" invisible="compute_price not in ['fixed', 'index']" style="width: 60% !important;">
                    <field name="fixed_price"
                        widget="monetary"
                        options="{'currency_field': 'currency_id', 'field_digits': True}"/>
                    <span class="d-flex gap-2 p-0" invisible="not product_uom">per<field
                            name="product_uom"/></span>
                </div>
            </xpath>
        </field>
    </record>

