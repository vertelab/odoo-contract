<odoo>

    <record id="contract_wizard" model="ir.ui.view">
        <field name="name">link.to.contract.view</field>
        <field name="model">agreement.contract.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="start_date"/>
                        <field name="end_date"/>
                        <separator/>
                        <field name="agreement_id" invisible="1"/>
                        <field name="recurring_start_date" required="type_of_cost_increase == 'index'"/>
                        <field name="cost_per_recurrence" invisible="type_of_cost_increase == 'index'"/>
                        <field name="contract_yearly_cost"/>
                        <field name="type_of_cost_increase"/>
                        <field name="consumer_index_base_year" invisible="type_of_cost_increase != 'index'" required="type_of_cost_increase == 'index'"/>
                        <field name="cost_index" invisible="type_of_cost_increase != 'percent'" required="type_of_cost_increase == 'percent'"/>
                    </group>
                    <group>
                        <field name="recurring_interval" invisible="type_of_cost_increase == 'index'"/>
                        <field name="recurring_rule_type" invisible="type_of_cost_increase == 'index'"/>
                        <field name="contract_template_id"/>
                    </group>
                </group>
                <footer>
                    <button name="save_button" type="object" string="Save" class="btn-primary"/>
                    <button name="cancel_button" type="object" string="Cancel" class="btn btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="open_link_to_contract_wizard">
        <field name="name">open.link.to.contract.wizard</field>
        <field name="res_model">agreement.contract.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="contract_wizard"/>
    </record>

</odoo>
