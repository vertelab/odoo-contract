<odoo>
    <data>
        <record id="contract_contract_form_view" model="ir.ui.view">
            <field name="name">contract.contract.form</field>
            <field name="model">contract.contract</field>
            <field name="inherit_id" ref="contract.contract_contract_form_view"/>
            <field name="arch" type="xml">
                <field name="user_id" position="after">
                    <field name="sale_id" />
                </field>
                <xpath expr="//page[@name='recurring_invoice_line']/field[@name='contract_line_fixed_ids']/list/field[@name='price_subtotal']" position="after">
                    <field name="sale_order_line_id" />
                </xpath>

                <div name="button_box" position="inside">
                    <button name="action_view_sales" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="sale_count == 0">
                        <field name="sale_count" widget="statinfo" string="Sales"/>
                    </button>
                </div>
            </field>
        </record>
    </data>
</odoo>
