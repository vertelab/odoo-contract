<openerp>
    <data>
        <record id="product_view" model="ir.ui.view">
            <field name="name">product.product.contract.view.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="product.product_template_form_view" />
            <field name="arch" type="xml">
                <div name="options" position='inside'>
                    <div>
                        <field name="is_contract" />
                        <label for="is_contract" />
                    </div>
                </div>
                <field name="categ_id" position="after">
                    <field name="contract_id" invisible="not is_contract" required="is_contract" />
                </field>

                <field name="product_tooltip" position="attributes">
                    <attribute name="invisible" separator="or" add="is_contract"/>
                </field>
            </field>
        </record>

        <record id="product_contract_template_form_view" model="ir.ui.view">
            <field name="name">product.contract.template.inherit.sale.project.form</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="sale.product_template_form_view"/>
            <field name="arch" type="xml">
                <field name="invoice_policy" position="attributes">
                    <attribute name="invisible" separator="or" add="is_contract"/>
                </field>
            </field>
        </record>

        <record id="product_contract_template_form_view_invoice_policy_inherit_sale_project" model="ir.ui.view">
            <field name="name">product.contract.template.inherit.sale.projectform</field>
            <field name="model">product.template</field>
            <field name="inherit_id" ref="sale_project.product_template_form_view_invoice_policy_inherit_sale_project"/>
            <field name="arch" type="xml">
                <field name="service_policy" position="attributes">
                    <attribute name="invisible" separator="or" add="is_contract"/>
                </field>
            </field>
        </record>

