<odoo>
    <data>

        <template id="portal_my_task" inherit_id="project.portal_my_task" name="Portal: AAW Task">
            <xpath expr="//div[@id='task-nav']" position="before">
                <t t-if="task.is_aaw and not task.is_signed">
                    <form t-attf-action="/my/tasks/sign/#{task.id}" method="post">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <button type="submit" class="btn btn-primary o_sign_btn d-block o_print_btn" title="Sign this task" style="width: 100%">
                            <i class="fa fa-pencil"/> Sign this AAW
                        </button>
                    </form>
                </t>
            </xpath>
        </template>

        <template t-name="aaw_sign_template_mail">
            <div>
                <span>
                    <t t-out="sender.name" />
                    (<a t-att-href="'mailto:%s?subject=%s' % (sender.email, 'Re: %s' % subject)" style="color:#428BCA; text-decoration:none;" target="_blank">
                    <t t-out="sender.email" />
                </a>)
                    has requested your signature on a document.
                </span>
                <span t-if="body">
                    <div style="margin: 16px 0px 16px 0px; padding: 8px 16px 8px 16px; background-color: #F1F1F1;">
                        <span>
                            <t t-out="body" />
                        </span>
                    </div>
                </span>
                <span>
                    <div style="margin:16px auto; text-align:center;">
                        <a
                                t-att-href="link"
                                style="padding: 8px 16px 8px 16px; border-radius: 3px; background-color:#875A7B; text-align:center; text-decoration:none; color: #FFFFFF;"
                        >
                            Sign document
                        </a>
                    </div>
                </span>
            </div>
        </template>


    </data>
</odoo>