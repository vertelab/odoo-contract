<odoo>
    <data>
        <record id="contract_template_form_view" model="ir.ui.view">
            <field name="name">contract.template.form</field>
            <field name="model">contract.template</field>
            <field name="inherit_id" ref="contract.contract_template_form_view"/>
            <field name="arch" type="xml">
                <field name="pricelist_id" position="after">
                    <field name="contract_payment_type"/>
                    <field name="down_payment" invisible="contract_payment_type == 'fixed'"/>
                    <field name="final_payment" invisible="contract_payment_type == 'fixed'"/>
                </field>
            </field>
        </record>
    </data>
</odoo>