<odoo>
    <data>
        <record id="view_project_task_form" model="ir.ui.view">
            <field name="name">project.task.form.view</field>
            <field name="model">project.task</field>
            <field name="inherit_id" ref="project.view_task_form2" />
            <field name="arch" type="xml">
                <xpath expr="//sheet//field[@name='milestone_id']" position="before">
                    <field name="is_aaw" invisible="not project_id.is_aaw" />
                    <field name="is_signed" invisible="1" />
                </xpath>
                <xpath expr="//header" position="inside">
                    <button name="action_request_signature" string="Request Signature" class="btn btn-primary" type="object" invisible="(is_signed and is_aaw) or not is_aaw"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
