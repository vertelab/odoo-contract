<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_contract_view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][1]" position="attributes">
                <attribute name="invisible">(invoice_status != 'to invoice') or is_contract</attribute>
            </xpath>
            <xpath expr="//button[@name='%(sale.action_view_sale_advance_payment_inv)d'][2]" position="attributes">
                <attribute name="invisible">(invoice_status != 'no') or (state != 'sale') or is_contract</attribute>
            </xpath>

            <div name="button_box" position="inside">
                <button type="object" name="action_view_contract" class="oe_stat_button" icon="fa-pencil-square-o" invisible="contract_count == 0" groups="base.group_user">
                    <field name="contract_count" widget="statinfo" string="Contracts" />
                </button>
            </div>
            <list position='inside'>
                <field name="contract_id" optional="hide" />
            </list>
        </field>
    </record>
</odoo>
