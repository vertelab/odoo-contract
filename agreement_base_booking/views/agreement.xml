<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="partner_agreement_form_view" model="ir.ui.view">
        <field name="name">Agreement Form</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement_legal.partner_agreement_form_view"/>
        <field name="arch" type="xml">
            <field name="assigned_user_id" position="after">
                <field name="booking_type_id" required="False"/>
                <field name="booking_resource_id" domain="[('booking_type_ids', 'in', booking_type_id)]"  invisible="booking_type_id == False" required="False"/>
                <field name="second_hand_booking_resource_id" readonly="0"/>
                <button type="object" name="make_resource_unavailable" invisible="calender_event_agreement_booking_id != False"  string="Make Resource Unavailable"/>
                <field name="calender_event_agreement_booking_id"/>
            </field>
        </field>
    </record>


    <record id="agreement_property_pivot_view" model="ir.ui.view">
        <field name="name">Agreement Property Pivot View</field>
        <field name="model">agreement</field>
        <field name="inherit_id" ref="agreement_legal.agreement_pivot_view"/>
        <field name="arch" type="xml">
            <xpath expr="//pivot" position="inside">
                <field name="booking_type_id"/>
                <field name="booking_resource_id"/>
            </xpath>
        </field>
    </record>
    
    
    <record id="booking_resource_view_form" model="ir.ui.view">
        <field name="name">booking.resource.form</field>
        <field name="model">booking.resource</field>
        <field name="inherit_id" ref="base_booking.booking_resource_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object" name="action_agreement" icon="fa-life-bouy" string="Agreements"/>
            </xpath>
        </field>
    </record>

</odoo>

