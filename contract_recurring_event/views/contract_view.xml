<odoo>
    <data>
        <record id="contract_contract_recurring_form_view" model="ir.ui.view">
            <field name="name">contract.contract.form</field>
            <field name="model">contract.contract</field>
            <field name="inherit_id" ref="contract.contract_contract_form_view"/>
            <field name="arch" type="xml">
                <page name="info" position="after">
                    <page string="Schedule" name="schedule_activity">
                        <group>
                            <group>
                                <field name="start"/>
                                <field name="duration" widget="float_time"/>
                            </group>
                            <div>
                                <group>
                                    <field name="recurrency"/>
                                </group>
                                <div invisible="not recurrency">
                                    <group>
                                        <label for="interval"/>
                                        <div class="o_row">
                                            <field name="interval" required="recurrency"/>
                                            <field name="rrule_type" required="recurrency"/>
                                        </div>
                                        <label string="Until" for="end_type"/>
                                        <div class="o_row">
                                            <field name="end_type" required="recurrency"/>
                                            <field name="count" invisible="end_type != 'count'" required="recurrency"/>
                                            <field name="until" invisible="end_type != 'end_date'" required="end_type == 'end_date' and recurrency"/>
                                        </div>
                                    </group>
                                    <group invisible="rrule_type != 'weekly'" name="weekdays">
                                        <field name="mo"/>
                                        <field name="tu"/>
                                        <field name="we"/>
                                        <field name="th"/>
                                        <field name="fr"/>
                                        <field name="sa"/>
                                        <field name="su"/>
                                    </group>
                                    <group invisible="rrule_type != 'monthly'">
                                        <label string="Day of Month" for="month_by"/>
                                        <div class="o_row">
                                            <field name="month_by"/>
                                            <field name="day" required="month_by == 'date' and rrule_type == 'monthly'" invisible="month_by != 'date'"/>
                                            <field name="byday" string="The" required="recurrency and month_by == 'day' and rrule_type == 'monthly'" invisible="month_by != 'day'"/>
                                            <field name="weekday" nolabel="1" required="recurrency and month_by == 'day' and rrule_type == 'monthly'" invisible="month_by != 'day'"/>
                                        </div>
                                    </group>
                                </div>
                            </div>
                        </group>
                    </page>
                </page>

                <button name="recurring_create_invoice" position="after">
                    <button name="action_create_calendar" type="object" string="Add to Calendar" invisible="is_terminated"/>
                </button>

                <button name="action_show_invoices" position="before">
<!--                    <button name="action_view_sales" type="object" class="oe_stat_button" icon="fa-pencil-square-o" invisible="sale_count == 0">-->
<!--                        <field name="sale_count" widget="statinfo" string="Sales"/>-->
<!--                    </button>-->
                    <button name="action_view_schedules" type="object" class="oe_stat_button" icon="fa-calendar" invisible="calendar_count == 0">
                        <field name="calendar_count" widget="statinfo" string="Schedule"/>
                    </button>
                </button>
            </field>
        </record>
    </data>
</odoo>
